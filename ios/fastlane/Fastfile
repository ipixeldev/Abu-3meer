default_platform(:ios)

def abu3meer_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_filepath: ENV.fetch("ABU_ASC_API_KEY_PATH") {
      ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH")
    },
    in_house: false
  )
end

def abu3meer_metadata(locale, filename)
  File.read(
    File.expand_path("metadata/#{locale}/#{filename}.txt", __dir__),
    encoding: "UTF-8"
  ).strip
end

def abu3meer_review_notes
  File.read(
    File.expand_path("review_notes.txt", __dir__),
    encoding: "UTF-8"
  ).strip
end

platform :ios do
  desc "Upload localized App Store metadata without changing the binary or submitting for review"
  lane :upload_metadata do
    api_key = abu3meer_api_key

    deliver(
      api_key: api_key,
      app_identifier: "com.abu3meer.app",
      app_version: "1.1.0",
      metadata_path: File.expand_path("metadata", __dir__),
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )

    app = Spaceship::ConnectAPI::App.find("com.abu3meer.app")
    version = app.get_app_store_versions.find { |candidate| candidate.version_string == "1.1.0" }
    UI.user_error!("App Store version 1.1.0 was not found") unless version
    version.fetch_app_store_review_detail.update(
      attributes: { notes: abu3meer_review_notes }
    )

    app_info = app.fetch_edit_app_info
    app_info.get_app_info_localizations.each do |localization|
      localization.update(
        attributes: {
          privacy_choices_url: "https://ipixeldev.github.io/Abu-3meer/delete-account/"
        }
      )
    end
    app_info.fetch_age_rating_declaration
      .update(
        attributes: {
          developer_age_rating_info_url: "https://ipixeldev.github.io/Abu-3meer/age-suitability/"
        }
      )
  end

  desc "Upload localized App Store screenshots without changing metadata, the binary, or review state"
  lane :upload_screenshots do
    deliver(
      api_key: abu3meer_api_key,
      app_identifier: "com.abu3meer.app",
      app_version: "1.1.0",
      platform: "ios",
      screenshots_path: File.expand_path("screenshots", __dir__),
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      skip_app_version_update: true,
      overwrite_screenshots: false,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )
  end

  lane :check_testflight do
    abu3meer_api_key

    app = Spaceship::ConnectAPI::App.find("com.abu3meer.app")
    builds = app.get_builds
    builds.each do |b|
      UI.success("TestFlight Build #{b.version} -> Processing State: #{b.processing_state} | Upload Date: #{b.uploaded_date}")
    end
  end

  desc "Upload an existing IPA and distribute it to both Abu 3meer TestFlight groups"
  lane :upload_testflight do |options|
    api_key = abu3meer_api_key
    ipa_path = options[:ipa] || ENV.fetch("IPA_PATH")
    app = Spaceship::ConnectAPI::App.find("com.abu3meer.app")
    beta_review = Spaceship::ConnectAPI
      .get_beta_app_review_detail(filter: { app: app.id })
      .to_models
      .first
    UI.user_error!("TestFlight review information is missing") unless beta_review

    localized_app_info = ["ar-SA", "en-US"].to_h do |locale|
      [
        locale,
        {
          feedback_email: beta_review.contact_email,
          marketing_url: abu3meer_metadata(locale, "marketing_url"),
          privacy_policy_url: abu3meer_metadata(locale, "privacy_url"),
          description: abu3meer_metadata(locale, "description")
        }
      ]
    end
    localized_build_info = ["ar-SA", "en-US"].to_h do |locale|
      [locale, { whats_new: abu3meer_metadata(locale, "release_notes") }]
    end

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      app_identifier: "com.abu3meer.app",
      localized_app_info: localized_app_info,
      localized_build_info: localized_build_info,
      beta_app_review_info: {
        contact_email: beta_review.contact_email,
        contact_first_name: beta_review.contact_first_name,
        contact_last_name: beta_review.contact_last_name,
        contact_phone: beta_review.contact_phone,
        demo_account_required: beta_review.demo_account_required,
        demo_account_name: beta_review.demo_account_name,
        demo_account_password: beta_review.demo_account_password,
        notes: beta_review.notes
      },
      distribute_external: true,
      groups: ["Abu 3meer External"],
      notify_external_testers: true,
      skip_waiting_for_build_processing: false,
      uses_non_exempt_encryption: false
    )
  end

  desc "Select an already processed build for App Store version 1.1.0 without submitting for review"
  lane :select_app_store_build do |options|
    abu3meer_api_key
    build_number = (options[:build_number] || ENV.fetch("APP_STORE_BUILD_NUMBER")).to_s
    app = Spaceship::ConnectAPI::App.find("com.abu3meer.app")
    build = Spaceship::ConnectAPI::Build.all(
      app_id: app.id,
      version: "1.1.0",
      build_number: build_number,
      platform: "IOS"
    ).first
    UI.user_error!("Build #{build_number} is not available in App Store Connect") unless build
    UI.user_error!("Build #{build_number} is not valid yet") unless build.processing_state == "VALID"

    version = app.get_app_store_versions(filter: { platform: "IOS" }).find do |candidate|
      candidate.version_string == "1.1.0"
    end
    UI.user_error!("App Store version 1.1.0 was not found") unless version
    version.select_build(build_id: build.id)
    UI.success("Selected build #{build_number} for App Store version 1.1.0")
  end

  desc "Submit App Store version 1.1.0 for review and release after approval"
  lane :submit_app_store_review do |options|
    build_number = (options[:build_number] || ENV.fetch("APP_STORE_BUILD_NUMBER", "12")).to_s
    deliver(
      api_key: abu3meer_api_key,
      app_identifier: "com.abu3meer.app",
      app_version: "1.1.0",
      build_number: build_number,
      platform: "ios",
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      submit_for_review: true,
      automatic_release: true,
      submission_information: {
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: true
      },
      run_precheck_before_submit: true,
      precheck_include_in_app_purchases: false,
      force: true
    )
  end
end
