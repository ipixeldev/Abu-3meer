rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function role() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'none';
    }
    function activeUser() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.suspended != true;
    }
    function admin() {
      return activeUser() && (role() == 'admin' || role() == 'superAdmin');
    }
    function contentManager() {
      return activeUser()
        && (admin() || role() == 'editor' || role() == 'contentManager');
    }
    function moderator() {
      return activeUser() && (admin() || role() == 'moderator');
    }
    function validTeam(team) {
      return team == 'Barcelona' || team == 'Real Madrid';
    }
    function validUsername(username) {
      return username is string
        && username.size() >= 3
        && username.size() <= 24
        && username.matches('^[a-z0-9_]+$');
    }
    function hasNoClientMembershipFields() {
      return !request.resource.data.keys().hasAny([
        'isYouTubeMember',
        'membershipMultiplier',
        'youtubeMembershipVerifiedAt',
        'youtubeVerifiedAt',
        'youtubeChannelId',
        'youtubeMemberSince'
      ]);
    }
    function keepsServerMembershipFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'isYouTubeMember',
        'membershipMultiplier',
        'youtubeMembershipVerifiedAt',
        'youtubeVerifiedAt',
        'youtubeChannelId',
        'youtubeMemberSince'
      ]);
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if (
        own(uid)
        && (!('role' in request.resource.data) || request.resource.data.role == 'user')
        && request.resource.data.suspended != true
        && hasNoClientMembershipFields()
      ) || admin();
      allow update: if admin() || (
        own(uid)
        && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
        && (!('suspended' in request.resource.data) || request.resource.data.suspended == resource.data.suspended)
        && keepsServerMembershipFields()
      );
      allow delete: if false;

      match /playerCards/{cardId} {
        allow read: if own(uid) || admin();
        allow write: if own(uid) || admin();
      }

      match /achievementProgress/{achievementId} {
        allow read: if own(uid) || admin();
        allow write: if own(uid) || admin();
      }
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    match /matches/{matchId} {
      allow read: if true;
      allow create, update: if contentManager();
      allow delete: if false;
    }

    match /predictions/{predictionId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /pointTransactions/{transactionId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /leaderboardEntries/{uid} {
      allow read: if true;
      allow create, update: if own(uid) || admin();
      allow delete: if false;
    }

    match /platformSettings/{settingId} {
      // These two documents drive public home-screen content and are safe for
      // signed-out fans to read. Other settings (including point economics)
      // remain available only to authenticated users.
      allow read: if signedIn()
        || settingId in ['launchAnnouncement', 'latestVideo'];
      // Point economics are only changed through the audited callable.
      allow write: if contentManager() && settingId != 'points';
    }

    match /achievementDefinitions/{achievementId} {
      allow read: if signedIn();
      allow write: if contentManager();
    }

    match /levelDefinitions/{levelId} {
      allow read: if signedIn();
      allow write: if contentManager();
    }

    match /loyaltyRewards/{rewardId} {
      allow read: if signedIn();
      allow write: if contentManager();
    }

    match /loyaltyRedemptions/{redemptionId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || contentManager());
      allow write: if false;
    }

    match /loyaltyTransactions/{transactionId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || admin());
      allow write: if false;
    }

    match /loyaltyRewardClaims/{claimId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || admin());
      allow write: if false;
    }

    match /leaderboardSeasons/{seasonId} {
      allow read: if signedIn();
      allow write: if contentManager();
      match /entries/{uid} {
        allow read: if signedIn();
        // Rankings are point-ledger output and may only be archived by trusted
        // backend code using the Admin SDK.
        allow write: if false;
      }
    }

    match /videoQuestions/{questionId} {
      allow read: if signedIn();
      allow write: if contentManager();
      match /private/{document} {
        allow read: if contentManager();
        allow write: if contentManager();
      }
      match /attempts/{uid} { allow read: if own(uid) || admin(); allow write: if false; }
    }

    match /playerCards/{cardId} {
      allow read: if signedIn();
      allow write: if contentManager();
      match /private/{document} {
        allow read: if contentManager();
        allow write: if contentManager();
      }
      match /attempts/{uid} { allow read: if own(uid) || admin(); allow write: if false; }
    }

    // Links a hidden Player Card challenge to its catalogue reward. Keeping
    // this mapping private prevents signed-in users from reading the answer by
    // joining a challenge ID to the public player name.
    match /playerCardChallengeLinks/{challengeId} {
      allow read, write: if contentManager();
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow write: if contentManager();
      match /reactions/{uid} {
        allow read: if signedIn();
        allow create, update: if own(uid)
          && activeUser()
          && request.resource.data.userId == uid;
        allow delete: if own(uid) && activeUser();
      }
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if activeUser()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1
          && request.resource.data.body.size() <= 800
          && request.resource.data.createdAt == request.time;
        allow update, delete: if moderator()
          || (activeUser() && resource.data.userId == request.auth.uid);
      }
    }

    match /duelRooms/{code} {
      allow read: if signedIn();
      allow create: if activeUser()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.guestUid == ''
        && request.resource.data.status == 'waiting';
      allow update: if activeUser()
        && resource.data.guestUid == ''
        && resource.data.hostUid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'guestUid', 'guestName', 'status', 'startAt'
        ])
        && request.resource.data.guestUid == request.auth.uid
        && request.resource.data.status == 'ready'
        && request.resource.data.startAt > request.time;
      allow delete: if activeUser() && resource.data.hostUid == request.auth.uid;

      match /taps/{uid} {
        allow read: if signedIn();
        allow create: if own(uid)
          && activeUser()
          && request.resource.data.userId == uid
          && request.resource.data.tappedAt == request.time
          && get(/databases/$(database)/documents/duelRooms/$(code)).data.status == 'ready'
          && request.time >= get(
            /databases/$(database)/documents/duelRooms/$(code)
          ).data.startAt
          && (uid == get(
            /databases/$(database)/documents/duelRooms/$(code)
          ).data.hostUid || uid == get(
            /databases/$(database)/documents/duelRooms/$(code)
          ).data.guestUid);
        allow update, delete: if false;
      }
    }

    match /adminAuditLogs/{logId} {
      allow read: if admin();
      allow create: if admin() && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if false;
    }

    // Server-created immutable receipts for manual XP corrections. These are
    // separate from the general audit stream so clients cannot forge, edit,
    // or remove before/after balances.
    match /adminPointAdjustments/{adjustmentId} {
      allow read: if admin();
      allow write: if false;
    }

    // Aggregated server-written signals. Raw IP addresses and installation
    // tokens are never stored; the backend records only peppered hashes.
    match /suspiciousEvents/{eventId} {
      allow read: if admin();
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'resolutionNote', 'resolvedAt', 'resolvedBy'
        ])
        && request.resource.data.status in [
          'open', 'reviewing', 'resolved', 'dismissed'
        ]
        && request.resource.data.resolvedBy == request.auth.uid
        && request.resource.data.resolvedAt == request.time;
      allow create, delete: if false;
    }

    // Callable-only security state. Client access would allow users to reset
    // counters or inspect replay fingerprints.
    match /securityRateLimits/{limitId} {
      allow read, write: if false;
    }

    match /securityIdempotency/{reservationId} {
      allow read, write: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
