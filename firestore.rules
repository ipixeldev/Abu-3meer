rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function role() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'none';
    }
    function admin() { return role() == 'admin' || role() == 'superAdmin'; }
    function contentManager() {
      return admin() || role() == 'editor' || role() == 'contentManager';
    }
    function moderator() { return admin() || role() == 'moderator'; }
    function validTeam(team) {
      return team == 'Barcelona' || team == 'Real Madrid';
    }
    function validUsername(username) {
      return username is string
        && username.size() >= 3
        && username.size() <= 24
        && username.matches('^[a-z0-9_]+$');
    }

    match /users/{uid} {
      allow read: if own(uid) || admin();
      allow create: if own(uid)
        && request.auth.token.email is string
        && request.resource.data.keys().hasOnly([
          'email', 'username', 'displayName', 'country', 'supportedTeam',
          'avatarUrl', 'role', 'membershipMultiplier', 'suspended',
          'totalPoints', 'monthlyPoints', 'seasonPoints', 'monthlyPeriod',
          'onboardingComplete', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.email == request.auth.token.email
        && validUsername(request.resource.data.username)
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.country is string
        && request.resource.data.country.size() >= 1
        && request.resource.data.country.size() <= 60
        && request.resource.data.country is string
        && request.resource.data.country.size() >= 1
        && request.resource.data.country.size() <= 60
        && validTeam(request.resource.data.supportedTeam)
        && request.resource.data.avatarUrl is string
        && request.resource.data.role == 'user'
        && request.resource.data.membershipMultiplier == 1
        && request.resource.data.suspended == false
        && request.resource.data.totalPoints == 0
        && request.resource.data.monthlyPoints == 0
        && request.resource.data.seasonPoints == 0
        && request.resource.data.onboardingComplete == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(
          /databases/$(database)/documents/usernames/$(request.resource.data.username)
        ).data.uid == uid
        && getAfter(
          /databases/$(database)/documents/leaderboardEntries/$(uid)
        ).data.username == request.resource.data.username;
      allow update: if (own(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'username', 'displayName', 'country', 'supportedTeam', 'avatarUrl',
          'updatedAt'
        ])
        && validUsername(request.resource.data.username)
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 60
        && validTeam(request.resource.data.supportedTeam)
        && getAfter(
          /databases/$(database)/documents/usernames/$(request.resource.data.username)
        ).data.uid == uid)
        || (admin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'role', 'suspended', 'updatedAt'
          ])
          && request.resource.data.role in [
            'user', 'moderator', 'editor', 'contentManager', 'admin'
          ]);
      allow delete: if false;

      match /playerCards/{cardId} {
        allow read: if own(uid) || admin();
        allow write: if false;
      }
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validUsername(username)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.username == username;
      allow update: if own(resource.data.uid)
        && request.resource.data.uid == resource.data.uid;
      allow delete: if own(resource.data.uid)
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.username != username;
    }

    match /matches/{matchId} {
      allow read: if signedIn();
      allow create: if admin()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.predictionOpensAt < request.resource.data.predictionClosesAt
        && request.resource.data.predictionClosesAt <= request.resource.data.kickoffAt;
      allow update, delete: if false;
    }

    match /predictions/{predictionId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());
      allow write: if false;
    }

    match /pointTransactions/{transactionId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());
      allow write: if false;
    }

    match /leaderboardEntries/{uid} {
      allow read: if signedIn();
      allow create: if own(uid)
        && request.resource.data.keys().hasOnly([
          'username', 'avatarUrl', 'supportedTeam', 'monthlyPoints',
          'seasonPoints', 'isMember', 'monthlyPeriod', 'updatedAt'
        ])
        && validUsername(request.resource.data.username)
        && request.resource.data.avatarUrl is string
        && validTeam(request.resource.data.supportedTeam)
        && request.resource.data.monthlyPoints == 0
        && request.resource.data.seasonPoints == 0
        && request.resource.data.isMember == false
        && request.resource.data.updatedAt == request.time
        && getAfter(
          /databases/$(database)/documents/users/$(uid)
        ).data.username == request.resource.data.username;
      allow update: if own(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'username', 'avatarUrl', 'supportedTeam', 'updatedAt'
        ])
        && request.resource.data.username == getAfter(
          /databases/$(database)/documents/users/$(uid)
        ).data.username;
      allow delete: if false;
    }

    match /platformSettings/{settingId} {
      allow read: if signedIn();
      allow write: if contentManager();
    }

    match /videoQuestions/{questionId} {
      allow read: if signedIn();
      allow write: if contentManager();
      match /private/{document} {
        allow read: if contentManager();
        allow write: if contentManager();
      }
      match /attempts/{uid} { allow read: if own(uid) || admin(); allow write: if false; }
    }

    match /playerCards/{cardId} {
      allow read: if signedIn();
      allow write: if contentManager();
      match /private/{document} {
        allow read: if contentManager();
        allow write: if contentManager();
      }
      match /attempts/{uid} { allow read: if own(uid) || admin(); allow write: if false; }
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow write: if contentManager();
      match /reactions/{uid} {
        allow read: if signedIn();
        allow create, update: if own(uid)
          && request.resource.data.userId == uid;
        allow delete: if own(uid);
      }
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1
          && request.resource.data.body.size() <= 800
          && request.resource.data.createdAt == request.time;
        allow update, delete: if moderator()
          || (signedIn() && resource.data.userId == request.auth.uid);
      }
    }

    match /duelRooms/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.guestUid == ''
        && request.resource.data.status == 'waiting';
      allow update: if signedIn()
        && resource.data.guestUid == ''
        && resource.data.hostUid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'guestUid', 'guestName', 'status', 'startAt'
        ])
        && request.resource.data.guestUid == request.auth.uid
        && request.resource.data.status == 'ready'
        && request.resource.data.startAt > request.time;
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      match /taps/{uid} {
        allow read: if signedIn();
        allow create: if own(uid)
          && request.resource.data.userId == uid
          && request.resource.data.tappedAt == request.time
          && get(/databases/$(database)/documents/duelRooms/$(code)).data.status == 'ready'
          && request.time >= get(
            /databases/$(database)/documents/duelRooms/$(code)
          ).data.startAt
          && (uid == get(
            /databases/$(database)/documents/duelRooms/$(code)
          ).data.hostUid || uid == get(
            /databases/$(database)/documents/duelRooms/$(code)
          ).data.guestUid);
        allow update, delete: if false;
      }
    }

    match /adminAuditLogs/{logId} {
      allow read: if admin();
      allow create: if admin() && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
