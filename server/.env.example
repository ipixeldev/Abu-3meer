# =================================================================
# Abu 3meer Production Environment Configuration
# =================================================================

# Server runtime
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
TZ=Europe/Stockholm

# Database (PostgreSQL via PgBouncer)
POSTGRES_DB=abu3meer_prod
POSTGRES_USER=abu3meer_admin
POSTGRES_PASSWORD=replace_with_strong_postgres_password
# Conservative defaults for a 4 GB host. Increase only after measuring memory.
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
POSTGRES_WORK_MEM=8MB
POSTGRES_MIN_WAL_SIZE=256MB
POSTGRES_MAX_WAL_SIZE=1GB
POSTGRES_MAX_CONNECTIONS=100
PGBOUNCER_MAX_DB_CONNECTIONS=90
DATABASE_URL=postgres://abu3meer_admin:replace_with_strong_postgres_password@127.0.0.1:6432/abu3meer_prod
DIRECT_DATABASE_URL=postgres://abu3meer_admin:replace_with_strong_postgres_password@127.0.0.1:5432/abu3meer_prod

# Redis Cache & Queue
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_MAXMEMORY=512mb

# Firebase Admin Credentials (For ID Token Verification & FCM)
FIREBASE_PROJECT_ID=abu-3meer-9fd70
FIREBASE_CLIENT_EMAIL=replace_with_firebase_admin_client_email
# Paste the JSON private_key value on one line. Preserve its literal \n escapes.
FIREBASE_PRIVATE_KEY="replace_with_escaped_firebase_private_key"

# Admin User Identification
ADMIN_EMAILS=replace_with_admin_email@example.com

# Exact browser/PWA origins allowed to call the API (comma separated). Native
# iOS and Android requests are unaffected by CORS.
CORS_ORIGINS=https://abu3meer.com,https://www.abu3meer.com,https://abu-3meer-9fd70.web.app,https://abu-3meer-9fd70.firebaseapp.com

# Cloudflare Tunnel Token (Get from Cloudflare Zero Trust Dashboard)
CLOUDFLARE_TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token

# Cloudflare R2 Media & Backup Storage (S3 compatible)
R2_ACCOUNT_ID=replace_with_r2_account_id
R2_ACCESS_KEY_ID=replace_with_r2_access_key_id
R2_SECRET_ACCESS_KEY=replace_with_r2_secret_access_key
R2_BUCKET_NAME=abu3meer-assets
R2_BACKUP_BUCKET=abu3meer-backups
R2_PUBLIC_URL=https://assets.abu3meer.com
BACKUP_ENCRYPTION_KEY=replace_with_backup_encryption_passphrase

# Persistent media stored on the home server. Point the public base URL at the
# Cloudflare Tunnel hostname that routes to this API. Leave blank during LAN
# testing so the API derives the origin from the incoming request.
UPLOAD_DIRECTORY=./uploads
UPLOAD_PUBLIC_BASE_URL=
UPLOAD_MAX_IMAGE_BYTES=8388608

# Local API bind. Keep loopback when Cloudflare Tunnel is the public entrypoint.
# Use 0.0.0.0 only when intentionally testing directly from another LAN device.
API_BIND_ADDRESS=127.0.0.1

# Application Points Defaults
SIGNUP_BONUS_POINTS=50
EXACT_SCORE_POINTS=30
FIRST_SCORER_POINTS=20
WINNER_OUTCOME_POINTS=10
VIDEO_PHRASE_POINTS=10
PLAYER_CARD_POINTS=10
DAILY_STREAK_POINTS=5
MEMBER_MULTIPLIER=2.0
# API-Football v3 Mega key. Keep this server-side; never add it to Flutter.
API_FOOTBALL_API_KEY=replace_with_api_football_key
API_FOOTBALL_FEATURED_TEAM_IDS=541,529
API_FOOTBALL_DAILY_REQUEST_BUDGET=140000

# Public TheSportsDB fallback used only when API_FOOTBALL_API_KEY is empty.
# A legacy 32-character API-Football key in SPORTSDB_API_KEY is auto-detected.
SPORTSDB_API_KEY=123
SPORTSDB_EVENT_CACHE_TTL_SECONDS=300
SPORTSDB_LIVE_CACHE_TTL_SECONDS=45
SPORTSDB_LINEUP_CACHE_TTL_SECONDS=1800
SPORTSDB_STANDINGS_CACHE_TTL_SECONDS=900
SPORTSDB_FIXTURE_CACHE_TTL_SECONDS=300
SPORTSDB_CATALOG_CACHE_TTL_SECONDS=21600
SPORTSDB_CATALOG_NEGATIVE_CACHE_TTL_SECONDS=300
SPORTSDB_NEGATIVE_CACHE_TTL_SECONDS=20
SPORTSDB_DAILY_REQUEST_BUDGET=140000
# Real Madrid, Barcelona. Keep this bounded because each unique team requires
# one provider request per fixture-cache window, shared by every app user.
SPORTSDB_FEATURED_TEAM_IDS=133738,133739
